#. Plugin Name of the plugin
#: rmd-opening-hours.php
msgid "RMD Opening Hours"
msgstr "RMD Öffnungszeiten"

#. Plugin URI of the plugin
#: rmd-opening-hours.php
msgid "https://github.com/reicheltmediadesign/wordpress-rmd-opening-hours"
msgstr "https://github.com/reicheltmediadesign/wordpress-rmd-opening-hours"

#. Description of the plugin
#: rmd-opening-hours.php
msgid "Manage regular and seasonal opening hours, show them as a block or shortcode, and announce upcoming changes automatically."
msgstr "Reguläre und abweichende Öffnungszeiten pflegen, als Block oder Shortcode anzeigen und Änderungen automatisch ankündigen."

#. Author of the plugin
#: rmd-opening-hours.php
msgid "Philipp Reichelt, reichelt media.design"
msgstr "Philipp Reichelt, reichelt media.design"

#. Author URI of the plugin
#: rmd-opening-hours.php
msgid "https://reicheltmedia.design"
msgstr "https://reicheltmedia.design"

